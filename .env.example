# Supabase — من إعدادات المشروع في supabase.com (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# اسم الـ bucket في Supabase Storage لتخزين صور الفواتير (أنشئه بنفس الاسم)
SUPABASE_INVOICES_BUCKET=invoices

# مفتاح Anthropic API — من console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# سر توقيع جلسات الدخول — أي نص عشوائي طويل، غيّره لقيمة خاصة بك
# يمكنك توليد واحد بالأمر: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-long-random-string
